<mujoco model="aloha_workbench_scene">
  <include file="scene.xml"/>

  <asset>
    <material name="red_mat" rgba="0.9 0.15 0.15 1" specular="0.8" shininess="0.8"/>
    <material name="blue_mat" rgba="0.15 0.3 0.9 1" specular="0.8" shininess="0.8"/>
    <material name="green_mat" rgba="0.15 0.85 0.3 1" specular="0.8" shininess="0.8"/>
  </asset>

  <worldbody>
    <!-- Head/Overhead Inspection Camera (aliased to head_cam for unified vision harness) -->
    <camera name="head_cam" pos="0 -0.303794 1.02524" mode="fixed" quat="0.976332 0.216277 0 0" fovy="58"/>

    <!-- Manipulation Props resting on table surface (Table surface at Z = 0.0m) -->
    <!-- Manipulation Props resting on table surface (Table surface at Z = 0.0m) -->
    <body name="red_mug" pos="0.16 0.0 0.026">
      <joint name="mug_joint" type="free" damping="0.8"/>
      <geom name="mug_body" type="cylinder" size="0.016 0.025" material="red_mat" mass="0.12" friction="2.0 0.05 0.005"/>
    </body>

    <body name="blue_block" pos="-0.16 0.0 0.018">
      <joint name="block_joint" type="free" damping="0.8"/>
      <geom name="block_body" type="box" size="0.016 0.016 0.016" material="blue_mat" mass="0.08" friction="2.0 0.05 0.005"/>
    </body>

    <body name="green_ball" pos="0.0 0.08 0.018">
      <joint name="ball_joint" type="free" damping="0.8"/>
      <geom name="ball_body" type="sphere" size="0.016" material="green_mat" mass="0.06" friction="1.5 0.05 0.005"/>
    </body>
  </worldbody>

  <equality>
    <weld name="weld_red_mug"         body1="right/gripper_link" body2="red_mug"    active="false"/>
    <weld name="weld_blue_block"       body1="right/gripper_link" body2="blue_block"  active="false"/>
    <weld name="weld_green_ball"       body1="right/gripper_link" body2="green_ball"  active="false"/>
    <weld name="weld_left_red_mug"    body1="left/gripper_link"  body2="red_mug"    active="false"/>
    <weld name="weld_left_blue_block"  body1="left/gripper_link"  body2="blue_block"  active="false"/>
    <weld name="weld_left_green_ball"  body1="left/gripper_link"  body2="green_ball"  active="false"/>
  </equality>
</mujoco>
