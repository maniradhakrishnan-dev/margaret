<mujoco model="g1_workbench_scene">
  <include file="g1_with_hands.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.2 0.2 0.2" specular="0.8 0.8 0.8"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    
    <material name="wood_mat" rgba="0.6 0.4 0.25 1" reflectance="0.1" roughness="0.6"/>
    <material name="red_mat" rgba="0.9 0.15 0.15 1" specular="0.8" shininess="0.8"/>
    <material name="blue_mat" rgba="0.15 0.3 0.9 1" specular="0.8" shininess="0.8"/>
    <material name="green_mat" rgba="0.15 0.85 0.3 1" specular="0.8" shininess="0.8"/>
  </asset>

  <worldbody>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <light directional="true" diffuse="0.8 0.8 0.8" specular="0.3 0.3 0.3" pos="0 0 4" dir="0 0 -1"/>
    <camera name="room_overview" pos="1.5 -1.5 1.5" euler="55 45 0" fovy="55"/>
    <camera name="head_cam" pos="0.06 0 1.25" euler="0 25 0" fovy="60"/>

    <!-- Workbench Table for Unitree G1 -->
    <body name="workbench" pos="0.35 0 0">
      <geom name="tabletop" type="box" size="0.15 0.35 0.02" pos="0 0 0.60" material="wood_mat"/>
      <geom name="leg1" type="cylinder" size="0.02 0.29" pos="0.11 0.31 0.29" rgba="0.2 0.2 0.2 1"/>
      <geom name="leg2" type="cylinder" size="0.02 0.29" pos="-0.11 0.31 0.29" rgba="0.2 0.2 0.2 1"/>
      <geom name="leg3" type="cylinder" size="0.02 0.29" pos="0.11 -0.31 0.29" rgba="0.2 0.2 0.2 1"/>
      <geom name="leg4" type="cylinder" size="0.02 0.29" pos="-0.11 -0.31 0.29" rgba="0.2 0.2 0.2 1"/>
    </body>

    <!-- Props resting gently on table top (Z=0.62m surface) -->
    <body name="red_mug" pos="0.30 -0.12 0.67">
      <joint name="mug_joint" type="free" damping="0.8"/>
      <geom name="mug_body" type="cylinder" size="0.03 0.04" material="red_mat" mass="0.15" friction="2.0 0.05 0.005"/>
    </body>

    <body name="blue_block" pos="0.30 0.12 0.65">
      <joint name="block_joint" type="free" damping="0.8"/>
      <geom name="block_body" type="box" size="0.025 0.025 0.025" material="blue_mat" mass="0.1" friction="2.0 0.05 0.005"/>
    </body>

    <body name="green_ball" pos="0.28 -0.04 0.65">
      <joint name="ball_joint" type="free" damping="0.8"/>
      <geom name="ball_body" type="sphere" size="0.025" material="green_mat" mass="0.08" friction="1.5 0.05 0.005"/>
    </body>
  </worldbody>

  <equality>
    <weld name="ground_pelvis"   body1="pelvis"/>
    <weld name="weld_red_mug"        body1="right_hand_middle_0_link" body2="red_mug"    active="false"/>
    <weld name="weld_blue_block"      body1="right_hand_middle_0_link" body2="blue_block"  active="false"/>
    <weld name="weld_green_ball"      body1="right_hand_middle_0_link" body2="green_ball"  active="false"/>
    <weld name="weld_left_red_mug"   body1="left_hand_middle_0_link"  body2="red_mug"    active="false"/>
    <weld name="weld_left_blue_block" body1="left_hand_middle_0_link"  body2="blue_block"  active="false"/>
    <weld name="weld_left_green_ball" body1="left_hand_middle_0_link"  body2="green_ball"  active="false"/>
  </equality>
</mujoco>