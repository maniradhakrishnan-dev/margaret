<mujoco model="robot_arena">
  <compiler angle="degree" inertiafromgeom="true"/>
  
  <default>
    <joint armature="0.5" damping="2" limited="true"/>
    <geom contype="1" conaffinity="1" condim="3" friction="0.8 0.1 0.1" rgba="0.8 0.6 0.4 1"/>
    <position kp="40" kv="4"/>
  </default>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.8 0.8 0.8" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1=".1 .2 .3" rgb2=".2 .3 .4"/>
    <material name="grid_mat" texture="grid" texrepeat="20 20" reflectance="0.2"/>

    <texture name="wood" type="2d" builtin="flat" width="512" height="512" rgb1="0.6 0.4 0.25" rgb2="0.5 0.35 0.2"/>
    <material name="wood_mat" texture="wood" reflectance="0.1" roughness="0.6"/>

    <material name="red_mat" rgba="0.9 0.15 0.15 1" specular="0.8" shininess="0.8"/>
    <material name="blue_mat" rgba="0.15 0.3 0.9 1" specular="0.8" shininess="0.8"/>
    <material name="green_mat" rgba="0.15 0.85 0.3 1" specular="0.8" shininess="0.8"/>
  </asset>

  <worldbody>
    <!-- 1. Arena Floor -->
    <geom name="floor" type="plane" size="10 10 0.1" material="grid_mat"/>

    <!-- 2. Room Lighting -->
    <light directional="true" diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2" pos="0 0 4" dir="0 0 -1"/>
    <light directional="false" diffuse="0.5 0.5 0.5" pos="2 -2 3" dir="-1 1 -1"/>

    <!-- 3. Room Overview Spectator Camera -->
    <camera name="room_overview" pos="1.8 -1.8 2.0" euler="55 45 0" fovy="55"/>

    <!-- 4. Wooden Workbench / Table -->
    <body name="workbench" pos="0.38 0 0">
      <geom name="tabletop" type="box" size="0.18 0.42 0.025" pos="0 0 0.725" material="wood_mat"/>
      <geom name="leg1" type="cylinder" size="0.025 0.35" pos="0.14 0.38 0.35" rgba="0.2 0.2 0.2 1"/>
      <geom name="leg2" type="cylinder" size="0.025 0.35" pos="-0.14 0.38 0.35" rgba="0.2 0.2 0.2 1"/>
      <geom name="leg3" type="cylinder" size="0.025 0.35" pos="0.14 -0.38 0.35" rgba="0.2 0.2 0.2 1"/>
      <geom name="leg4" type="cylinder" size="0.025 0.35" pos="-0.14 -0.38 0.35" rgba="0.2 0.2 0.2 1"/>
    </body>

    <!-- 5. Interactive Physics Props (Resting gently on top of table surface at z=0.75m) -->
    <body name="red_mug" pos="0.35 -0.12 0.81">
      <freejoint name="mug_joint"/>
      <geom name="mug_body" type="cylinder" size="0.035 0.045" material="red_mat" mass="0.2" friction="1.2 0.01 0.001"/>
    </body>

    <body name="blue_block" pos="0.35 0.12 0.79">
      <freejoint name="block_joint"/>
      <geom name="block_body" type="box" size="0.03 0.03 0.03" material="blue_mat" mass="0.15" friction="1.0 0.01 0.001"/>
    </body>

    <body name="green_ball" pos="0.35 0.0 0.79">
      <freejoint name="ball_joint"/>
      <geom name="ball_body" type="sphere" size="0.03" material="green_mat" mass="0.1" friction="0.8 0.01 0.001"/>
    </body>

    <!-- 6. Humanoid Robot (Solidly standing at 1.25m facing the table) -->
    <body name="torso" pos="0 0 1.25">
      <geom name="torso1" type="capsule" fromto="0 -.07 0 0 .07 0" size="0.07"/>
      <geom name="head" type="sphere" pos="0 0 .19" size=".09" rgba="0.9 0.7 0.5 1"/>
      <camera name="head_cam" pos="0.08 0 0.19" euler="0 15 0" fovy="60"/>
      <geom name="uwaist" type="capsule" fromto="-.01 -.06 -.12 -.01 .06 -.12" size="0.06"/>

      <!-- Waist & Lower Body -->
      <body name="lwaist" pos="-.01 0 -.260">
        <joint name="abdomen_z" type="hinge" pos="0 0 0.065" axis="0 0 1" range="-45 45"/>
        <joint name="abdomen_y" type="hinge" pos="0 0 0.065" axis="0 1 0" range="-75 30"/>
        <geom name="lwaist" type="capsule" fromto="0 -.06 0 0 .06 0" size="0.06"/>
        <body name="pelvis" pos="0 0 -.165">
          <joint name="abdomen_x" type="hinge" pos="0 0 0.1" axis="1 0 0" range="-35 35"/>
          <geom name="butt" type="capsule" fromto="-.02 -.07 0 -.02 .07 0" size="0.09"/>

          <!-- Right Leg -->
          <body name="right_thigh" pos="0 -.1 -.04">
            <joint name="hip_x_right" type="hinge" axis="1 0 0" range="-25 5"/>
            <joint name="hip_z_right" type="hinge" axis="0 0 1" range="-60 35"/>
            <joint name="hip_y_right" type="hinge" axis="0 1 0" range="-120 20"/>
            <geom name="right_thigh1" type="capsule" fromto="0 0 0 0 .01 -.34" size="0.06"/>
            <body name="right_shin" pos="0 .01 -.403">
              <joint name="knee_right" type="hinge" axis="0 -1 0" range="-160 -2"/>
              <geom name="right_shin1" type="capsule" fromto="0 0 0 0 0 -.3" size="0.049"/>
              <body name="right_foot" pos="0 0 -.39">
                <joint name="ankle_y_right" type="hinge" pos="0 0 .08" axis="0 1 0" range="-50 50"/>
                <joint name="ankle_x_right" type="hinge" pos="0 0 .04" axis="1 0 0.5" range="-50 50"/>
                <geom name="right_foot_cap" type="capsule" fromto="-.07 0 0 .14 0 0" size="0.045"/>
              </body>
            </body>
          </body>

          <!-- Left Leg -->
          <body name="left_thigh" pos="0 .1 -.04">
            <joint name="hip_x_left" type="hinge" axis="-1 0 0" range="-25 5"/>
            <joint name="hip_z_left" type="hinge" axis="0 0 -1" range="-60 35"/>
            <joint name="hip_y_left" type="hinge" axis="0 1 0" range="-120 20"/>
            <geom name="left_thigh1" type="capsule" fromto="0 0 0 0 -.01 -.34" size="0.06"/>
            <body name="left_shin" pos="0 -.01 -.403">
              <joint name="knee_left" type="hinge" axis="0 -1 0" range="-160 -2"/>
              <geom name="left_shin1" type="capsule" fromto="0 0 0 0 0 -.3" size="0.049"/>
              <body name="left_foot" pos="0 0 -.39">
                <joint name="ankle_y_left" type="hinge" pos="0 0 .08" axis="0 1 0" range="-50 50"/>
                <joint name="ankle_x_left" type="hinge" pos="0 0 .04" axis="1 0 0.5" range="-50 50"/>
                <geom name="left_foot_cap" type="capsule" fromto="-.07 0 0 .14 0 0" size="0.045"/>
              </body>
            </body>
          </body>
        </body>
      </body>

      <!-- Right Arm -->
      <body name="right_upper_arm" pos="0 -.17 .06">
        <joint name="shoulder1_right" type="hinge" axis="2 1 1" range="-85 60"/>
        <joint name="shoulder2_right" type="hinge" axis="0 -1 1" range="-85 60"/>
        <geom name="right_uarm1" type="capsule" fromto="0 0 0 .16 -.16 -.16" size="0.04"/>
        <body name="right_lower_arm" pos=".18 -.18 -.18">
          <joint name="elbow_right" type="hinge" axis="0 -1 1" range="-90 50"/>
          <geom name="right_larm" type="capsule" fromto=".01 .01 .01 .17 .17 .17" size="0.031"/>
          <body name="right_hand" pos=".18 .18 .18">
            <geom name="right_hand_geom" type="sphere" size="0.04" rgba="0.9 0.2 0.2 1"/>
            <site name="right_palm" pos="0 0 0" size="0.01"/>
          </body>
        </body>
      </body>

      <!-- Left Arm -->
      <body name="left_upper_arm" pos="0 .17 .06">
        <joint name="shoulder1_left" type="hinge" axis="2 -1 1" range="-60 85"/>
        <joint name="shoulder2_left" type="hinge" axis="0 1 1" range="-60 85"/>
        <geom name="left_uarm1" type="capsule" fromto="0 0 0 .16 .16 -.16" size="0.04"/>
        <body name="left_lower_arm" pos=".18 .18 -.18">
          <joint name="elbow_left" type="hinge" axis="0 -1 -1" range="-90 50"/>
          <geom name="left_larm" type="capsule" fromto=".01 -.01 .01 .17 -.17 .17" size="0.031"/>
          <body name="left_hand" pos=".18 -.18 .18">
            <geom name="left_hand_geom" type="sphere" size="0.04" rgba="0.2 0.2 0.9 1"/>
            <site name="left_palm" pos="0 0 0" size="0.01"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- Position-Controlled Servos for Precise, Smooth Motion -->
  <actuator>
    <position name="abdomen_z"       joint="abdomen_z"       kp="60" kv="6"/>
    <position name="abdomen_y"       joint="abdomen_y"       kp="60" kv="6"/>
    <position name="abdomen_x"       joint="abdomen_x"       kp="60" kv="6"/>
    <position name="hip_x_right"     joint="hip_x_right"     kp="50" kv="5"/>
    <position name="hip_z_right"     joint="hip_z_right"     kp="50" kv="5"/>
    <position name="hip_y_right"     joint="hip_y_right"     kp="80" kv="8"/>
    <position name="knee_right"      joint="knee_right"      kp="80" kv="8"/>
    <position name="ankle_y_right"   joint="ankle_y_right"   kp="30" kv="3"/>
    <position name="ankle_x_right"   joint="ankle_x_right"   kp="30" kv="3"/>
    <position name="hip_x_left"      joint="hip_x_left"      kp="50" kv="5"/>
    <position name="hip_z_left"      joint="hip_z_left"      kp="50" kv="5"/>
    <position name="hip_y_left"      joint="hip_y_left"      kp="80" kv="8"/>
    <position name="knee_left"       joint="knee_left"       kp="80" kv="8"/>
    <position name="ankle_y_left"    joint="ankle_y_left"    kp="30" kv="3"/>
    <position name="ankle_x_left"    joint="ankle_x_left"    kp="30" kv="3"/>
    <position name="shoulder1_right" joint="shoulder1_right" kp="45" kv="4"/>
    <position name="shoulder2_right" joint="shoulder2_right" kp="45" kv="4"/>
    <position name="elbow_right"     joint="elbow_right"     kp="50" kv="5"/>
    <position name="shoulder1_left"  joint="shoulder1_left"  kp="45" kv="4"/>
    <position name="shoulder2_left"  joint="shoulder2_left"  kp="45" kv="4"/>
    <position name="elbow_left"      joint="elbow_left"      kp="50" kv="5"/>
  </actuator>

  <!-- Equality constraints for dexterous grasping & lifting -->
  <equality>
    <weld name="weld_red_mug"   body1="right_hand" body2="red_mug"   active="false"/>
    <weld name="weld_blue_block" body1="right_hand" body2="blue_block" active="false"/>
    <weld name="weld_green_ball" body1="right_hand" body2="green_ball" active="false"/>
  </equality>
</mujoco>
